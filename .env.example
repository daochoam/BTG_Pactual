# ---------------------------------------------------------------------------
# Variables SOLO para desarrollo local.
#
# En AWS no hace falta configurar DynamoDB ni Cognito: serverless.yml los crea
# y sus identificadores se inyectan automáticamente en la Lambda.
# ---------------------------------------------------------------------------

ENVIRONMENT_MODE=development

# Credenciales locales (en Lambda las provee el rol de ejecución)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# Región usada por `serverless deploy` (no se inyecta a la Lambda).
# El bucket de artefactos lo crea y gestiona Serverless: no hay que declararlo.
AWS_DEPLOY_REGION=us-east-2

# Prefijo de tablas en local. Vacío = tablas "Users", "Categories", ...
TABLE_PREFIX=

# DynamoDB Local (docker compose up -d). Comenta esta línea para trabajar
# contra la cuenta real de AWS: la app CREARÁ las tablas allí al arrancar.
DYNAMO_ENDPOINT_URL=http://localhost:8000

# Crea/ajusta las tablas al arrancar la app (por defecto true en development)
AUTO_CREATE_TABLES=true

# Cognito: solo para local. En AWS los inyecta CloudFormation.
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_CLIENT_SECRET=
AWS_COGNITO_DOMAIN=

# S3 / CloudFront: en AWS los inyecta CloudFormation. Solo para local.
S3_UPLOADS_BUCKET=
S3_STATIC_SITE_BUCKET=
CDN_URL=

# Solo se usan al desplegar (no viajan al entorno de la Lambda)
CORS_ALLOWED_ORIGIN=*
CDN_PRICE_CLASS=PriceClass_100
API_RATE_LIMIT=100
API_BURST_LIMIT=200

# Correo (SES / SMTP). En AWS estos valores se leen de SSM Parameter Store
# (/<servicio>/<stage>/...); aquí solo hacen falta para desarrollo local.
# La verificación de identidades en SES sigue requiriendo confirmación manual.
SES_VERIFIED_EMAIL=
AWS_SMTP_HOST=email-smtp.us-east-2.amazonaws.com
AWS_SMTP_PORT=587
AWS_SMTP_USER=
AWS_SMTP_PASS=

# JWT
JWT_SECRET_KEY=cambia-esto
JWT_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

TIME_ZONE=America/Bogota
