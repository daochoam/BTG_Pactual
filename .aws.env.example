# Copiar a `.aws.env` (esta en .gitignore) y ajustar.
#
# Este archivo dice QUE identidad usar para desplegar ESTE proyecto.
# NO pongas aqui AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY: las credenciales
# viven en ~/.aws/credentials, que es un archivo del usuario con permisos del
# sistema operativo y que nunca entra en el repositorio.
#
# Lo usa scripts/with-aws-env.js, que envuelve los comandos de despliegue:
#   npm run deploy        ->  serverless deploy con este perfil
#   npm run bootstrap     ->  aws cloudformation deploy con este perfil

# Perfil de ~/.aws/config. Lo mas recomendable es un perfil de AWS SSO
# (IAM Identity Center): son credenciales temporales, no hay claves que rotar.
AWS_PROFILE=btg-pactual

# Region de despliegue de este proyecto.
AWS_DEPLOY_REGION=us-east-2

# Opcional: fija el stage por defecto de los scripts de npm.
# STAGE=dev
